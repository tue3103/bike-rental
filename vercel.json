{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/quanly", "destination": "/quanly.html" },
    { "source": "/tracuu", "destination": "/tracuu.html" }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(css|js|images)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
